$Profiles = Get-CimInstance -ClassName Win32_UserProfile -ComputerName $ComputerName -ErrorAction Stop |
                    Where-Object { -not $_.Special -and $_.LocalPath -like "*\Users\*" }

        $StaleList    = [System.Collections.Generic.List[string]]::new()
        $DeletedCount = 0

        # Filter profiles older than threshold
        $StaleProfiles = $Profiles | Where-Object {
            $UserName = Split-Path $_.LocalPath -Leaf
            ($ExcludedUsers -notcontains $UserName) -and ($_.LastUseTime) -and ($_.LastUseTime -lt $CutoffDate)
            $UserName
        }
